NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional path to a private, local-only env file containing ADMIN_EMAIL and
# ADMIN_PASSWORD for one-time administrator bootstrap. Keep that file outside synced
# folders; remove it and this setting after changing the temporary password.
# PORTAL_ADMIN_SECRET_FILE=C:\Users\your-name\AppData\Local\GradePortal\admin-bootstrap.env

# Optional: set this to import a specific workbook instead of the local SQLite database.
# PORTAL_MIGRATION_WORKBOOK=C:\path\to\grade5-portal-database.xlsx

# Optional when deploying to a hosting provider.
# HOST=0.0.0.0
# PORT=3003

# Set to true only behind a TLS-terminating reverse proxy (Render, Railway, Fly.io, nginx).
# It allows non-TLS binding, marks session cookies Secure from X-Forwarded-Proto, and
# rate-limits sign-ins by the proxy-supplied client address. Never enable it when the
# server is directly reachable from the internet.
# PORTAL_TRUST_PROXY=true
